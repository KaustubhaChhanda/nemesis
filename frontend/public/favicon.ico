<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64" fill="none">
  <!-- Rounded White Badge for Universal High Contrast on Dark and Light Browser Tabs -->
  <rect width="64" height="64" rx="15" fill="#ffffff" />
  <rect x="0.75" y="0.75" width="62.5" height="62.5" rx="14.25" stroke="#e4e4e7" stroke-width="1.5" />

  <!-- Centered Nemesis Network Graph Logo matching NemesisLogo.tsx -->
  <g transform="translate(8, 8) scale(1.2)">
    <!-- Primary Graph Edges -->
    <line x1="20" y1="6" x2="34" y2="22" stroke="#09090b" stroke-width="2" stroke-linecap="round" />
    <line x1="20" y1="6" x2="6" y2="22" stroke="#09090b" stroke-width="2" stroke-linecap="round" />
    <line x1="6" y1="22" x2="20" y2="34" stroke="#09090b" stroke-width="2" stroke-linecap="round" />
    <line x1="34" y1="22" x2="20" y2="34" stroke="#09090b" stroke-width="2" stroke-linecap="round" />
    <line x1="20" y1="6" x2="20" y2="34" stroke="#71717a" stroke-width="1.3" stroke-linecap="round" stroke-dasharray="2 3" />
    <line x1="6" y1="22" x2="34" y2="22" stroke="#71717a" stroke-width="1.3" stroke-linecap="round" />
    <!-- Secondary Cross Edges -->
    <line x1="20" y1="6" x2="6" y2="10" stroke="#a1a1aa" stroke-width="1.1" stroke-linecap="round" />
    <line x1="20" y1="6" x2="34" y2="10" stroke="#a1a1aa" stroke-width="1.1" stroke-linecap="round" />

    <!-- Nodes -->
    <circle cx="20" cy="6" r="4.2" fill="#09090b" />
    <circle cx="6" cy="22" r="3.2" fill="#ffffff" stroke="#09090b" stroke-width="2.2" />
    <circle cx="34" cy="22" r="3.2" fill="#ffffff" stroke="#09090b" stroke-width="2.2" />
    <circle cx="20" cy="34" r="4.2" fill="#09090b" />
    <circle cx="6" cy="10" r="2.2" fill="#71717a" />
    <circle cx="34" cy="10" r="2.2" fill="#71717a" />
  </g>
</svg>
