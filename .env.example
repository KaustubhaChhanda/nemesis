# Nemesis Environment Configuration

# PostgreSQL
POSTGRES_USER=nemesis
POSTGRES_PASSWORD=nemesis_secret_2026
POSTGRES_DB=nemesis
DATABASE_URL=postgresql+asyncpg://nemesis:nemesis_secret_2026@localhost:5432/nemesis

# Neo4j
NEO4J_AUTH=neo4j/nemesis_graph_2026
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nemesis_graph_2026

# Redis
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379/0

# Tor
TOR_SOCKS_PROXY=socks5h://localhost:9050

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# JWT
JWT_SECRET=nemesis_jwt_secret_change_in_production_2026
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Admin seed account
ADMIN_USERNAME=investigator
ADMIN_PASSWORD=nemesis_admin_2026

# Collector settings
MAX_CRAWL_DEPTH=3
MAX_PAGES_PER_SOURCE=50
MAX_CRAWL_RUNTIME_SECONDS=300
CRAWL_INTERVAL_MINUTES=30

# Application
APP_NAME=Nemesis
APP_VERSION=0.1.0
DEBUG=true
